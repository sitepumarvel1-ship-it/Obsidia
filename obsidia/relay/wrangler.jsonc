{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidia-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "JOB", "class_name": "Job" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub", "Job"] }
  ],
  "observability": { "enabled": true }
}
